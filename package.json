{
  "name": "althus-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "ALTHUS by DATALIS — Sistema de Gestão e Inteligência para Comércio Varejista (MVP v1.1)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "varejo",
    "gestao",
    "precificacao",
    "indicadores",
    "mvp"
  ],
  "author": "DATALIS SOLUÇÕES",
  "license": "UNLICENSED"
}
