# ==============================================================
# ALTHUS by DATALIS (v1.1) — Variáveis de Ambiente de Exemplo
# ==============================================================

# Porta e Ambiente do Servidor
PORT=3333
NODE_ENV=development
API_HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Conexão PostgreSQL / Supabase
# Substitua com sua connection string do Supabase (Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres

# Chaves Supabase (opcionais se acessar direto pelo Prisma/Postgres)
SUPABASE_URL=https://[SEU_PROJETO].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Autenticação e Segurança
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-for-security-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Criptografia e Proteção de Dados (ADR-002 / LGPD)
# Chave de criptografia AES-256 (32 bytes em hexadecimal)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Chave secreta Pepper para Blind Index do CPF/CNPJ (HMAC-SHA256)
BLIND_INDEX_PEPPER=pepper-secret-key-do-not-share-keep-in-vault-32ch
